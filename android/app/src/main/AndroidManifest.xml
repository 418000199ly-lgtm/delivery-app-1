<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- 渠道分流（2026-11-24）：driver=司机版（默认，锁屏亮屏提醒全开）；
             store=商店版（华为审核版，CI 构建时把 value 改为 store 并把下方
             activity 的 showWhenLocked/turnScreenOn 改为 false，去掉锁屏覆盖，
             对应华为审核第 2 条）。MainActivity 启动时读此值决定是否开锁屏开关。 -->
        <meta-data
            android:name="heiwan_channel"
            android:value="driver" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 2026-11-26 原生听单定位前台服务：定位与上报全在原生侧完成，
             不依赖 WebView，切后台/锁屏持续上报（根治看门狗误踢下线）。 -->
        <service
            android:name=".HeiwanLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 2026-11-01 自更新：App 内下载新版后拉起系统安装所需 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 2026-10-24：后台定位权限。插件清单不自带此声明，缺它时系统权限页只给
         「仅使用期间允许/禁止」、不出现「始终允许」（用户安卓真机实报）。
         声明后权限页出现「始终允许」，听单切后台/进程重启后仍可恢复上报。 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 存储权限 (Storage) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- 相机权限 (Camera) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 2026-11-17 上架合规：删除从未调用的麦克风/通讯录/日历权限声明（App 无录音、不读通讯录与日历，
         拨打乘客电话走系统拨号盘 tel: 不需要通讯录权限），避免商店隐私扫描追问 -->

    <!-- 悬浮窗与后台强弹/全屏意图权限 (System Alert Window / Full Screen Intent) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 2026-11-26 原生听单定位：定位型前台服务声明（Android 14+ 必需）与电池优化豁免请求 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- 音频与震动 (Audio & Vibration) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
